# Gomic API local development
ADDR=:18090
ADMIN_TOKEN=dev-token
DATABASE_URL=postgres://gomic:gomic_dev_password@localhost:5432/gomic?sslmode=disable
UPLOAD_DIR=./uploads

# Force in-memory seed mode instead of PostgreSQL. Leave unset/0 for DB mode.
GOMIC_USE_SEED=0

# Optional JSON HTTP source bridge. If SOURCE_URL is empty, only mock-mihon is registered.
SOURCE_ID=json-http
SOURCE_NAME=JSON HTTP Source
SOURCE_URL=
# Format: Header: value separated by | or newlines.
SOURCE_HEADERS=User-Agent: GomicBot/1.0|Referer: https://source.example/
IMAGE_HEADERS=User-Agent: GomicBot/1.0|Referer: https://source.example/

# Cleanup policy. Set any value to 0 to disable that part.
CLEANUP_INTERVAL=1h
JOB_RETENTION=168h
CACHE_TTL=720h
